# Imagen de Node usada para copiar node, npm y paquetes globales.
NODE_IMAGE=node:22-bookworm

# Version de pnpm instalada globalmente.
PNPM_VERSION=11.15.1

# Version de yarn instalada globalmente.
YARN_VERSION=1.22.22

# Imagen usada para copiar el binario de Composer.
COMPOSER_IMAGE=composer:2.8.11

# Imagen base de PHP/Apache para Laravel (PHP 8.5 o php:8.3-apache-bookworm para estabilidad)
PHP_IMAGE=php:8.5-apache-bookworm

# Puertos expuestos para el entorno de desarrollo (Ajustados para evitar conflictos)
APP_PORT=8090
VITE_PORT=5174
FORWARD_DB_PORT=33084
PHPMYADMIN_PORT=8094
FORWARD_REDIS_PORT=63795
FORWARD_MAILPIT_PORT=8026
FORWARD_MAILPIT_SMTP_PORT=1026

# Credenciales y base de datos de MySQL 8.4 LTS
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=laravel
MYSQL_USER=laravel_user
MYSQL_PASSWORD=laravel_pass
